# ==============================================================================
# Docker Compose Project Configuration
# ==============================================================================
# Prefix used for container names, networks, and volumes
COMPOSE_PROJECT_NAME=starter_template

# ==============================================================================
# Port Mappings (Host : Container)
# ==============================================================================
# Port for Nginx reverse proxy (exposes Laravel backend / API)
NGINX_PORT=8000

# Port for Vite development server (React frontend)
FRONTEND_PORT=5173

# Port for MySQL database access on host
DB_PORT=3306

# ==============================================================================
# Database Configuration (MySQL 8.0)
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=app_database
DB_USERNAME=app_user
DB_PASSWORD=secret_password
DB_ROOT_PASSWORD=root_secret_password

# ==============================================================================
# Laravel Backend Settings
# ==============================================================================
APP_NAME="Web Project Template"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Cache & Session drivers
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Frontend CORS Origin URL
FRONTEND_URL=http://localhost:5173

# ==============================================================================
# React / Vite Frontend Settings
# ==============================================================================
VITE_APP_NAME="Web Project Template"
VITE_API_BASE_URL=http://localhost:8000/api

# Feed oficial de destinos e traçados STCP (GTFS)
STCP_GTFS_URL=https://opendata.porto.digital/dataset/5275c986-592c-43f5-8f87-aabbd4e4f3a4/resource/042603c9-4eae-4f9d-88a1-b443892e21cf/download/gtfs_feed.zip
